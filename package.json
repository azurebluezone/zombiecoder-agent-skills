{
  "name": "zombiecoder-agent-skills",
  "version": "1.0.0",
  "description": "Portable, audited skill library for AI agents: SQLite + JSONL data, deterministic router, Python and Node CLIs.",
  "main": "node/index.js",
  "bin": {
    "zombie-skills": "node/bin/cli.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "node/",
    "python/",
    "server/",
    "packs/",
    "data/",
    "examples/",
    "docs/",
    "skills.jsonl",
    "terms.jsonl",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node node/test.js",
    "check:packs": "python3 tools/check_skill_packs.py",
    "check:extra": "python3 tools/check_extra_packs.py",
    "check:remaining": "python3 tools/check_remaining_packs.py",
    "check:mcp": "python3 tools/check_skill_mcp.py",
    "install:skills": "python3 tools/install_opencode_skills.py",
    "mcp": "python3 server/skill_mcp.py"
  },
  "keywords": [
    "agents",
    "skills",
    "sqlite",
    "llm",
    "router",
    "jsonl",
    "mcp"
  ],
  "license": "MIT"
}
